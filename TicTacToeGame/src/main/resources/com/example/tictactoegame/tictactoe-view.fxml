<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.tictactoegame.TicTacToeController">
    <padding>
        <Insets bottom="30.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label>PLAYER 'X' GOES FIRST</Label>
    <Label fx:id="playerXText" text="Player X's Turn!"/>

    <GridPane fx:id="buttonpane" alignment="CENTER" hgap="1" vgap="1">
        <Button text=""  GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="0" GridPane.columnIndex="2" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="1" GridPane.columnIndex="0" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="1" GridPane.columnIndex="2" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="2" GridPane.columnIndex="0" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
        <Button text=""  GridPane.rowIndex="2" GridPane.columnIndex="2" prefWidth="50" prefHeight="50" onAction="#onButtonXClicked"></Button>
    </GridPane>
</VBox>
